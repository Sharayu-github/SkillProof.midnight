# Midnight network to connect to. One of: preview | preprod | undeployed (devnet)
VITE_NETWORK_ID=preview

# OPTIONAL: a deployed SkillProof contract to auto-join on startup.
# Leave empty to deploy a fresh contract from the browser, or paste the
# address printed by `npm run setup -- --network preview`.
VITE_CONTRACT_ADDRESS=

# OPTIONAL: pasting the issuer secret key (the seed from .midnight-state.json)
# unlocks the issuer-only "verify" action in the browser.
VITE_ISSUER_SECRET_KEY=
